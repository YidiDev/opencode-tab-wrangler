{
  "name": "opencode-tab-wrangler",
  "version": "0.1.0",
  "description": "Configurable, safety-first tab housekeeping for the OpenCode terminal",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YidiDev/opencode-tab-wrangler.git"
  },
  "homepage": "https://github.com/YidiDev/opencode-tab-wrangler#readme",
  "bugs": {
    "url": "https://github.com/YidiDev/opencode-tab-wrangler/issues"
  },
  "exports": {
    "./tui": "./tui.ts"
  },
  "files": [
    "tui.ts",
    "src",
    "schema.json",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && bun run schema:check && bun test",
    "schema": "bun tools/schema.ts",
    "schema:check": "bun tools/schema.ts --check",
    "test:live": "python3 tools/pty-smoke.py --cleanup",
    "test:package": "python3 tools/package-smoke.py",
    "test:coverage": "bun test --coverage"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opentui/core": ">=0.6.8 <0.7.0",
    "@opentui/solid": ">=0.6.8 <0.7.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/bun": "^1.3.0",
    "prettier": "^3.6.2",
    "solid-js": "1.9.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "packageManager": "bun@1.4.0"
}
